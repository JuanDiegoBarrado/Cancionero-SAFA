{
	"latex-workshop.latex.autoBuild.run": "never",
    "latex-workshop.latex.recipe.default": "xelatex (with index)",
    "latex-workshop.latex.recipes": [
        {
            "name": "xelatex (with index)",
            "tools": ["xelatexmk", "canciones", "aclamaciones", "xelatexmk"]
        },
		{
			"name": "xelatex",
			"tools": ["xelatexmk"]
		}
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "xelatexmk",
            "command": "latexmk",
            "args": [
                "-xelatex",
                "-interaction=nonstopmode",
                "-synctex=1",
                "-outdir=./build/",	// compilation files folder
                "%DOC%"
            ]
        },
		{
            "name": "canciones",
            "command": "texlua",
            "args": [
                "%DIR%/scripts/songidx.lua", // copia local parcheada (pliega tildes al ordenar/agrupar el índice)
                "%DIR%/build/idxfile.sxd", // this is the name of the index file
                "%DIR%/build/idxfile.sbx"	 // this is the name of the index file
            ]
        },
		{
            "name": "aclamaciones",
            "command": "texlua",
            "args": [
                "%DIR%/scripts/songidx.lua", // copia local parcheada (pliega tildes al ordenar/agrupar el índice)
                "%DIR%/build/idxfile2.sxd", // this is the name of the index file
                "%DIR%/build/idxfile2.sbx"	 // this is the name of the index file
            ]
        }
    ]
}