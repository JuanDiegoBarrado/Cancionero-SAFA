{
	"latex-workshop.latex.autoBuild.run": "never",
    "latex-workshop.latex.recipe.default": "xelatex (with index)",
    "latex-workshop.latex.recipes": [
        {
            "name": "xelatex (with index)",
            "tools": ["xelatexmk", "songidx", "xelatexmk"]
        },
		{
			"name": "xelatex",
			"tools": ["xelatexmk"]
		}
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "xelatexmk",
            "command": "latexmk",
            "args": [
                "-xelatex",
                "-interaction=nonstopmode",
                "-synctex=1",
                "-outdir=./aux/",	// compilation files folder
                "%DOC%"
            ]
        },
		{
            "name": "songidx",
            "command": "texlua",
            "args": [
                "C:/Program Files/MiKTeX/scripts/songs/songidx.lua", // TODO this should be added to the path
                "%DIR%/aux/idxfile.sxd", // this is the name of the index file
                "%DIR%/aux/idxfile.sbx"	 // this is the name of the index file
            ]
        }
    ]
}
